rules_version = '2';

// Reglas de Firestore para ArgenGame. Pegalas en Firestore → Reglas → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {
    // Perfil propio (nombre y desafíos) para recuperarlo al entrar con Google en otro celular.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'groups'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 20
        && request.resource.data.groups is list
        && request.resource.data.groups.size() <= 30;
    }

    match /groups/{gid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.owner == request.auth.uid;
      // Solo quien creó el desafío lo arranca o lanza la revancha.
      allow update: if request.auth != null
        && resource.data.owner == request.auth.uid
        && request.resource.data.owner == resource.data.owner;

      match /members/{uid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 20;
      }

      match /plays/{pid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null
          && pid.matches(request.auth.uid + '_.*')
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.used <= 3
          && request.resource.data.changuis <= 3;
      }
    }
  }
}
